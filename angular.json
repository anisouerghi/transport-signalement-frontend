{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "transport-signalement-frontend": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              { "glob": "**/*", "input": "public" },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets",
                "ignore": ["config/**"]
              },
              {
                "glob": "config.json",
                "input": "src/assets/config/development",
                "output": "assets/config"
              }
            ],
            "styles": ["src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "1.2mb", "maximumError": "2mb" }
              ],
              "outputHashing": "all",
              "assets": [
                { "glob": "**/*", "input": "public" },
                {
                  "glob": "**/*",
                  "input": "src/assets",
                  "output": "assets",
                  "ignore": ["config/**"]
                },
                {
                  "glob": "config.json",
                  "input": "src/assets/config/production",
                  "output": "assets/config"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json",
            "port": 4200,
            "host": "0.0.0.0"
          },
          "configurations": {
            "production": { "buildTarget": "transport-signalement-frontend:build:production" },
            "development": { "buildTarget": "transport-signalement-frontend:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
